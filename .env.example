# Copie para .env e preencha. O arquivo .env NÃO vai para o GitHub.
VITE_GITHUB_USER=Henriquenascimento-eng

# Supabase (Settings > API): login do dashboard, mensagens e projetos em destaque
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (opcional): envio da mensagem por e-mail ao dono do site
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
